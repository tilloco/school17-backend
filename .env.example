# PostgreSQL ulanish manzili
DATABASE_URL="postgresql://postgres:password@localhost:5432/huquq_db?schema=public"

# JWT token uchun maxfiy kalit (ixtiyoriy uzun tasodifiy satr qo'ying)
JWT_SECRET="o'zgartiring-bu-yerga-uzun-random-satr"
JWT_EXPIRES_IN="30d"

# Eskiz.uz SMS provayder (https://eskiz.uz/ dan ro'yxatdan o'tib oling)
ESKIZ_EMAIL="sizning-email@example.com"
ESKIZ_PASSWORD="sizning-parolingiz"
ESKIZ_BASE_URL="https://notify.eskiz.uz/api"

# Serverdagi port
PORT=3000

# Server nginx/load balancer kabi proksi ortida ishlasa - proksi qatlamlari soni
# (odatda 1). To'g'ridan-to'g'ri internetga ochiq bo'lsa (proksisiz), 0 qiling.
# MUHIM: bu noto'g'ri sozlansa, IP-asosli so'rov cheklovlari (rate limiting) ishlamay
# qolishi yoki chetlab o'tilishi mumkin.
TRUST_PROXY=1

# production rejimida server faqat shu qiymat "production" bo'lganda qo'shimcha
# tekshiruvlarni yoqadi (majburiy maxfiy kalitlar, qattiqroq CORS va h.k.)
NODE_ENV=development

# Admin panel login token'lari uchun maxfiy kalit - JWT_SECRET'dan BOSHQA, alohida
# uzun tasodifiy satr bo'lsin (shunda foydalanuvchi va admin tokenlari hech qachon
# bir-birining o'rniga ishlamaydi). Birinchi adminni yaratish: npm run admin:create
ADMIN_JWT_SECRET="yana-boshqa-uzun-tasodifiy-satr"
ADMIN_JWT_EXPIRES_IN="12h"

# OTP kodlarini hash qilish uchun maxfiy "pepper" (uzun, tasodifiy, JWT_SECRET dan boshqa qiymat)
# Buni o'zgartirsangiz, hozir bazada turgan barcha eski OTP kodlari avtomatik yaroqsiz bo'ladi (bu normal)
OTP_PEPPER="yana-bir-uzun-random-satr"

# Mobil ilova va admin panel domenlari, vergul bilan ajratilgan (production'da MAJBURIY to'ldiring)
# Masalan: ALLOWED_ORIGINS="https://admin.huquqtest.uz,exp://192.168.1.5:8081"
# Lokal development uchun admin panel odatda http://localhost:3001 da ishga tushadi
ALLOWED_ORIGINS="http://localhost:3001"

# --- Click.uz (Merchant kabinetdan olinadi: https://merchant.click.uz) ---
CLICK_SERVICE_ID=""
CLICK_MERCHANT_ID=""
CLICK_SECRET_KEY=""
# To'lovdan keyin foydalanuvchi qaytariladigan sahifa (mobil ilova deep link ham bo'lishi mumkin)
CLICK_RETURN_URL="https://example.com/payment-success"

# --- Payme (Merchant kabinetdan olinadi: https://business.payme.uz) ---
PAYME_MERCHANT_ID=""
# Merchant API kaliti - Payme JSON-RPC so'rovlarini "Authorization: Basic base64(Paycom:KEY)" bilan tekshirish uchun
PAYME_MERCHANT_KEY=""
PAYME_RETURN_URL="https://example.com/payment-success"

# --- AI shaxsiylashtirilgan tavsiyalar (Anthropic Claude API) ---
# https://console.anthropic.com dan olinadi. E'TIBOR: bu kalit FAQAT backend'da
# saqlanadi - mobil ilova yoki admin panelga hech qachon yuborilmaydi/ko'rinmaydi.
# Bo'sh qoldirilsa, tizim avtomatik ravishda AI'siz (bazadagi statistikaga asoslangan
# deterministik) tavsiyaga o'tadi - funksiya sinmaydi, faqat kamroq "aqlli" bo'ladi.
ANTHROPIC_API_KEY=""

