{
  "name": "huquq-backend",
  "version": "0.1.0",
  "description": "Huquq imtihoniga tayyorgarlik - backend API",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node prisma/seed.ts",
    "admin:create": "ts-node prisma/create-admin.ts",
    "test": "node --require ts-node/register/transpile-only --test --test-concurrency=1 \"src/**/*.spec.ts\" \"../shared/*.spec.ts\"",
    "test:unit": "node --require ts-node/register/transpile-only --test \"src/**/*.unit.spec.ts\" \"../shared/*.spec.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:dev": "bash scripts/dev-db.sh start"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/throttler": "^6.7.0",
    "@nestjs/websockets": "^10.4.22",
    "@prisma/client": "^5.20.0",
    "axios": "^1.7.7",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "expo-linear-gradient": "~57.0.2",
    "google-auth-library": "^11.1.0",
    "helmet": "^7.1.0",
    "multer": "^2.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfjs-dist": "3.11.174",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.16.5",
    "@types/passport-jwt": "^4.0.1",
    "prisma": "^5.20.0",
    "puppeteer-core": "^23.11.1",
    "socket.io-client": "^4.8.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
