generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentProvider {
  CLICK
  PAYME
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ReferralStatus {
  PENDING
  REWARDED
}

enum AdminRole {
  SUPERADMIN
  EDITOR
}

enum QuestionType {
  CLOSED
  OPEN
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum Role {
  STUDENT
  GUARDIAN
  TEACHER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum GuardianLinkStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum AuditActorType {
  USER
  ADMIN
  SYSTEM
}

model User {
  role                    Role               @default(STUDENT)
  dateOfBirth             DateTime?
  locale                  String             @default("uz")
  timezone                String             @default("Asia/Tashkent")
  status                  AccountStatus      @default(ACTIVE)
  deletedAt               DateTime?
  guardianLinksAsGuardian GuardianLink[]     @relation("GuardianSide")
  guardianLinksAsStudent  GuardianLink[]     @relation("StudentSide")
  teacherProfile          TeacherProfile?    @relation("TeacherProfileUser")
  storedFiles             StoredFile[]       @relation("FileOwner")
  bookingsAsStudent       Booking[]          @relation("BookingStudent")
  bookingsMade            Booking[]          @relation("BookingBookedBy")
  classEnrollments        ClassEnrollment[]  @relation("ClassPupil")
  classEnrolledBy         ClassEnrollment[]  @relation("ClassEnrolledBy")
  notifications           Notification[]     @relation("UserNotifications")
  threadsAsTeacher        ChatThread[]       @relation("ThreadTeacher")
  threadsAsStudent        ChatThread[]       @relation("ThreadStudent")
  chatMessagesSent        ChatMessage[]      @relation("MessageSender")
  reviewsWritten          Review[]           @relation("ReviewAuthor")
  reportsMade             Report[]           @relation("ReportReporter")
  blocksMade              UserBlock[]        @relation("BlockerSide")
  blockedBy               UserBlock[]        @relation("BlockedSide")
  linkCodes               GuardianLinkCode[] @relation("LinkCodeStudent")
  consents                Consent[]          @relation("UserConsents")
  pushTokens              PushToken[]        @relation("UserPushTokens")
  dailyStudyMinutes       Int?
  selfLevel               String?
  onboardingCompleted     Boolean            @default(false)
  onboarding              OnboardingSession?
  id                      String             @id @default(uuid())
  email                   String             @unique
  name                    String?
  avatarUrl               String?
  examDate                DateTime?
  isPremium               Boolean            @default(false)
  premiumExpiresAt        DateTime?
  referralCode            String             @unique
  referredByCode          String?
  walletBalance           Int                @default(0) // so'mda, butun son
  createdAt               DateTime           @default(now())

  progress                 UserProgress[]
  answers                  UserAnswer[]
  streak                   Streak?
  payments                 Payment[]
  examSessions             ExamSession[]
  referralsMade            Referral[]                @relation("Referrer")
  referralReceived         Referral?                 @relation("ReferredUser")
  withdrawals              Withdrawal[]
  premiumGrants            PremiumGrant[]
  aiRecommendation         AiRecommendation?
  conversationParticipants ConversationParticipant[]
  messagesSent             Message[]
}

model Module {
  id        String   @id @default(uuid())
  title     String
  order     Int
  weeks     Week[]
  createdAt DateTime @default(now())
}

model Week {
  id        String   @id @default(uuid())
  moduleId  String
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title     String
  order     Int
  lessons   Lesson[]
  createdAt DateTime @default(now())
}

model Lesson {
  id           String         @id @default(uuid())
  weekId       String
  week         Week           @relation(fields: [weekId], references: [id], onDelete: Cascade)
  title        String
  content      String         @db.Text // 5-10 daqiqalik matn
  order        Int
  articleLabel String? // masalan "12-18-moddalar" - dashboardda "bugun nima o'qidingiz" uchun
  questions    Question[]
  progress     UserProgress[]
  createdAt    DateTime       @default(now())
}

model Question {
  id           String       @id @default(uuid())
  lessonId     String
  lesson       Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  text         String       @db.Text
  options      String[] // 4 ta variant (faqat CLOSED turi uchun)
  correctIndex Int // faqat CLOSED turi uchun
  explanation  String       @db.Text
  answers      UserAnswer[]
  createdAt    DateTime     @default(now())

  // Milliy sertifikat mock imtihoni uchun qo'shimcha maydonlar
  questionType QuestionType @default(CLOSED)
  difficulty   Int          @default(1) // 1 yoki 2 - yopiq savol ballini aniqlaydi (1.3 yoki 2.2)
  concepts     String[]     @default([]) // savol mavzulari, masalan: ["mulk_huquqi", "shartnoma_huquqi"]
  partAPrompt  String?      @db.Text // faqat OPEN turi uchun
  partAAnswer  String?      @db.Text // namunaviy javob (AI shu bilan solishtiradi)
  partBPrompt  String?      @db.Text
  partBAnswer  String?      @db.Text

  examAnswers ExamAnswer[]
}

model UserProgress {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([userId, lessonId])
  @@index([userId, completedAt])
}

model UserAnswer {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  chosenIndex Int
  isCorrect   Boolean
  answeredAt  DateTime @default(now())
}

model Streak {
  id               String    @id @default(uuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentCount     Int       @default(0)
  longestCount     Int       @default(0) // eng yaxshi natija - doim ko'rsatiladi, hatto streak uzilsa ham
  lastActiveDate   DateTime? // kunning boshiga normallashtirilgan (UTC 00:00)
  freezesAvailable Int       @default(0) // bir kun o'tkazib yuborilsa streak'ni saqlab qoladi
  freezesUsedTotal Int       @default(0)
  lastMilestoneHit Int       @default(0) // oxirgi mukofot berilgan bosqich - qayta bermaslik uchun
  updatedAt        DateTime  @updatedAt
}

model Referral {
  id             String         @id @default(uuid())
  referrerId     String
  referrer       User           @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUserId String         @unique
  referredUser   User           @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)
  rewardAmount   Int            @default(0)
  status         ReferralStatus @default(PENDING)
  createdAt      DateTime       @default(now())

  @@index([referrerId])
}

// Foydalanuvchi hamyonidagi (referral bonuslaridan yig'ilgan) pulni yechib olish so'rovi.
// So'rov yuborilganda summasi walletBalance'dan darhol ayiriladi (double-spend'ning oldini olish
// uchun) - REJECTED bo'lsa qaytariladi, APPROVED/PAID bo'lsa qaytarilmaydi.
model Withdrawal {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int
  status      WithdrawalStatus @default(PENDING)
  note        String?          @db.Text
  requestedAt DateTime         @default(now())
  processedAt DateTime?

  @@index([userId])
  @@index([status])
}

// Premium berilgan har bir hodisani audit qilish uchun (to'lov, referral bonusi yoki admin
// tomonidan qo'lda berilgan) - kelajakda "premium qayerdan kelyapti" statistikasi uchun foydali.
model PremiumGrant {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  months    Int
  source    String // 'PAYMENT' | 'REFERRAL_BONUS' | 'ADMIN_GRANT'
  createdAt DateTime @default(now())

  @@index([userId])
}

model Payment {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int // so'mda (Payme ichkarida tiyinga o'giradi, chunki ular shu birlikda ishlaydi)
  months    Int             @default(1) // sotib olinayotgan premium necha oylik
  provider  PaymentProvider
  status    PaymentStatus   @default(PENDING)
  // Click uchun merchant_prepare_id/merchant_trans_id sifatida, Payme javoblarida "transaction"
  // maydoni sifatida ishlatiladigan qisqa, ketma-ket raqam (UUID emas - provayderlar buni kutadi)
  seq       Int             @unique @default(autoincrement())
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  clickTransactions ClickTransaction[]
  paymeTransactions PaymeTransaction[]
}

enum ClickTransactionState {
  CREATED // Prepare bosqichi o'tdi, Complete kutilmoqda
  CONFIRMED // Complete muvaffaqiyatli
  CANCELLED
}

// Click SHOP API ikki bosqichli (Prepare -> Complete): shu jarayonning holatini alohida
// jadvalda kuzatamiz - shunda bitta Payment uchun bir necha urinish bo'lsa ham (masalan
// foydalanuvchi to'lovni bekor qilib, qayta urinsa) hech narsa yo'qolmaydi/chalkashmaydi.
model ClickTransaction {
  id            Int                   @id @default(autoincrement()) // Click'ga merchant_prepare_id sifatida qaytariladi
  paymentId     String
  payment       Payment               @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  clickTransId  String                @unique // Click tomonidagi tranzaksiya ID (click_trans_id)
  clickPaydocId String?
  state         ClickTransactionState @default(CREATED)
  createdAt     DateTime              @default(now())
  confirmedAt   DateTime?
  cancelledAt   DateTime?

  @@index([paymentId])
}

enum PaymeTransactionState {
  CREATED // 1 - yaratilgan, hali to'lanmagan
  COMPLETED // 2 - muvaffaqiyatli to'langan
  CANCELLED // -1 - to'lanishdan oldin bekor qilingan
  CANCELLED_AFTER_COMPLETE // -2 - to'langandan keyin bekor qilingan (pul qaytarilgan)
}

// Payme JSON-RPC Merchant API talab qiladigan holat mashinasi (CheckPerform -> Create ->
// Perform -> Cancel). paymeId - Payme'dan kelgan tranzaksiya identifikatori, @unique -
// shu orqali CreateTransaction bir necha marta chaqirilsa ham (tarmoq retry) ikkinchi marta
// yangi yozuv yaratilmaydi (idempotentlik).
model PaymeTransaction {
  id          String                @id @default(uuid())
  paymeId     String                @unique
  paymentId   String
  payment     Payment               @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount      Int // tiyinda (Payme shu birlikda yuboradi)
  state       PaymeTransactionState @default(CREATED)
  reason      Int?
  createTime  DateTime              @default(now())
  performTime DateTime?
  cancelTime  DateTime?

  @@index([paymentId])
}

model Admin {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         AdminRole @default(EDITOR)
  createdAt    DateTime  @default(now())
}

// Premium foydalanuvchi uchun AI (Anthropic Claude) tomonidan generatsiya qilingan
// shaxsiylashtirilgan tavsiya. Har bir foydalanuvchi uchun BITTA yozuv (userId @unique) -
// yangi tavsiya generatsiya qilinganda ustidan yoziladi (tarix saqlanmaydi, faqat oxirgisi).
// "content" - AI javobi tekshirilgan/tozalangandan keyingi strukturaviy JSON (AiService'dagi
// shaklga mos: summary, focusAreas, studyPlan, motivation, examReadiness).
// Bu yozuv ikki maqsadga xizmat qiladi: (1) kesh - har so'rovda qimmat AI chaqiruvini
// takrorlamaslik, (2) audit - AI qachon nima tavsiya qilgani tarixda (oxirgisi) qolishi.
model AiRecommendation {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model OnboardingSession {
  id        String   @id @default(cuid())
  userId    String   @unique
  status    String   @default("in_progress") // in_progress | completed
  history   Json     @default("[]") // [{ question, answer }]
  profile   Json? // final structured profile once completed
  plan      Json? // final personalized welcome plan once completed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

enum ExamSessionStatus {
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

model ExamSession {
  id          String            @id @default(uuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      ExamSessionStatus @default(IN_PROGRESS)
  startedAt   DateTime          @default(now())
  expiresAt   DateTime // startedAt + 150 daqiqa
  submittedAt DateTime?
  totalScore  Float?
  maxScore    Float?
  percentage  Float?
  grade       String?

  answers ExamAnswer[]

  @@index([userId])
}

model ExamAnswer {
  id            String      @id @default(uuid())
  examSessionId String
  examSession   ExamSession @relation(fields: [examSessionId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question    @relation(fields: [questionId], references: [id])

  // CLOSED turi uchun
  chosenIndex Int?
  isCorrect   Boolean?

  // OPEN turi uchun
  partAText    String?  @db.Text
  partBText    String?  @db.Text
  partACorrect Boolean?
  partBCorrect Boolean?

  pointsEarned Float    @default(0)
  createdAt    DateTime @default(now())

  @@index([examSessionId])
}

enum ConversationType {
  DM
  GROUP
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  FILE
}

model Conversation {
  id        String           @id @default(uuid())
  type      ConversationType @default(DM)
  name      String? // faqat GROUP uchun keyinroq
  createdAt DateTime         @default(now())

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime? // "o'qilmagan xabarlar" hisoblash uchun keyinroq

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  type           MessageType  @default(TEXT)
  content        String?      @db.Text // TEXT va emoji shu yerda (emoji = oddiy unicode matn)
  mediaUrl       String? // IMAGE/VIDEO/FILE uchun — keyinroq to'ldiriladi
  mediaFileName  String?
  mediaSizeBytes Int?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model GuardianLink {
  id         String             @id @default(uuid())
  guardianId String
  guardian   User               @relation("GuardianSide", fields: [guardianId], references: [id], onDelete: Cascade)
  studentId  String
  student    User               @relation("StudentSide", fields: [studentId], references: [id], onDelete: Cascade)
  status     GuardianLinkStatus @default(PENDING)
  createdAt  DateTime           @default(now())

  @@unique([guardianId, studentId])
  @@index([studentId])
}

// Append-only: servislar faqat create qiladi, hech qachon update/delete qilmaydi.
model AuditLog {
  id         String         @id @default(uuid())
  actorType  AuditActorType
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime       @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
}

// ---------------- Marketplace: o'qituvchi profillari (S2) ----------------

enum VerificationStatus {
  DRAFT
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum CredentialKind {
  DEGREE
  CERTIFICATE
  ID_DOCUMENT
  OTHER
}

enum CredentialStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StoredFilePurpose {
  PAYMENT_PROOF
  CREDENTIAL
  MESSAGE_ATTACHMENT
  AVATAR
  CLASS_FILE
  HOMEWORK
}

enum FileScanStatus {
  NOT_SCANNED
  CLEAN
  INFECTED
  ERROR
}

enum StoredFileStatus {
  PENDING_UPLOAD
  UPLOADED
  QUARANTINED
  READY
  REJECTED
}

model StoredFile {
  id                  String              @id @default(uuid())
  ownerId             String
  owner               User                @relation("FileOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  purpose             StoredFilePurpose
  originalName        String
  mime                String?
  sizeBytes           Int                 @default(0)
  declaredSize        Int                 @default(0)
  storageKey          String              @unique
  sha256              String?
  finalMime           String?
  scanStatus          FileScanStatus      @default(NOT_SCANNED)
  thumbKey            String?
  width               Int?
  height              Int?
  pageCount           Int?
  chunkSize           Int                 @default(1048576)
  completedAt         DateTime?
  deletedAt           DateTime?
  rejectReason        String?
  status              StoredFileStatus    @default(PENDING_UPLOAD)
  createdAt           DateTime            @default(now())
  credentials         TeacherCredential[]
  messages            ChatMessage[]
  directPaymentProofs DirectPayment[]     @relation("DirectPaymentProof")

  @@index([ownerId, createdAt])
}

model TeacherProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation("TeacherProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  headline           String             @default("")
  bio                String             @default("") @db.Text
  subjects           String[]
  levels             String[]
  languages          String[]
  priceMinor         Int                @default(0) // 60 daqiqalik dars narxi, tiyin (1 so'm = 100 tiyin)
  currency           String             @default("UZS")
  introVideoUrl      String?
  instantBooking     Boolean            @default(false)
  paymentTiming      PaymentTiming      @default(PAY_AFTER)
  photoFileId        String? // StoredFile (AVATAR) — profil surati
  verificationStatus VerificationStatus @default(DRAFT)
  verifiedAt         DateTime?
  verifiedByAdminId  String?
  rejectionReason    String?
  submittedAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  ratingCount        Int                @default(0)
  ratingSum          Int                @default(0)
  ratingBayes        Float              @default(0)

  availability AvailabilityRule[]
  timeOff      TeacherTimeOff[]
  credentials  TeacherCredential[]
  bookings     Booking[]           @relation("TeacherBookings")
  classes      Class[]             @relation("TeacherClasses")
  storageQuotaMb      Int? // admin tomonidan oshirilgan kvota (MB); bo'sh = standart
  reviews      Review[]            @relation("TeacherReviews")
  paymentInfo  TeacherPaymentInfo?

  @@index([verificationStatus])
  @@index([priceMinor])
}

model AvailabilityRule {
  id          String         @id @default(uuid())
  teacherId   String
  teacher     TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  weekday     Int // ISO: 1=Dushanba ... 7=Yakshanba (o'qituvchining o'z vaqt zonasida)
  startMinute Int // kun boshidan daqiqalar (mahalliy vaqt)
  endMinute   Int

  @@index([teacherId, weekday])
}

model TeacherTimeOff {
  id        String         @id @default(uuid())
  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  startAt   DateTime
  endAt     DateTime
  reason    String?

  @@index([teacherId, startAt])
}

model TeacherCredential {
  id         String           @id @default(uuid())
  teacherId  String
  teacher    TeacherProfile   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  kind       CredentialKind
  title      String
  fileId     String
  file       StoredFile       @relation(fields: [fileId], references: [id], onDelete: Restrict)
  status     CredentialStatus @default(PENDING)
  reviewedAt DateTime?
  reviewNote String?
  createdAt  DateTime         @default(now())

  @@index([teacherId])
}

// ---------------- Marketplace: bron (S3) ----------------

enum BookingStatus {
  REQUESTED
  CONFIRMED
  DECLINED
  EXPIRED
  CANCELLED
  COMPLETED
  NO_SHOW_STUDENT
  NO_SHOW_TEACHER
  FAILED
}

model Booking {
  id                String         @id @default(uuid())
  teacherId         String // TeacherProfile.id
  teacher           TeacherProfile @relation("TeacherBookings", fields: [teacherId], references: [id], onDelete: Restrict)
  studentId         String // dars oluvchi (o'quvchi)
  student           User           @relation("BookingStudent", fields: [studentId], references: [id], onDelete: Restrict)
  bookedById        String // bronni yaratgan: o'quvchining o'zi yoki vasiy
  bookedBy          User           @relation("BookingBookedBy", fields: [bookedById], references: [id], onDelete: Restrict)
  startAt           DateTime
  endAt             DateTime
  durationMin       Int
  priceMinor        Int
  currency          String         @default("UZS")
  status            BookingStatus  @default(REQUESTED)
  requestExpiresAt  DateTime?
  decidedAt         DateTime?
  cancelledAt       DateTime?
  cancelledByUserId String?
  cancelledByRole   String? // STUDENT | GUARDIAN | TEACHER | SYSTEM
  cancelReason      String?
  lateCancel        Boolean        @default(false)
  proposedStartAt   DateTime?
  proposedById      String?
  noShowMarkedAt    DateTime?
  actualDurationSec Int?
  outcomeNote       String?
  callRooms         CallRoom[]     @relation("BookingCallRooms")
  review            Review?        @relation("BookingReview")
  isTrial           Boolean        @default(false)
  directPayment     DirectPayment? @relation("BookingDirectPayment")
  payment           LessonPayment? @relation("BookingPayment")
  completedAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([teacherId, startAt])
  @@index([studentId, startAt])
  @@index([bookedById])
  @@index([status, startAt])
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type      String // masalan: booking.requested, booking.reminder
  data      Json?
  dueAt     DateTime  @default(now())
  sentAt    DateTime?
  readAt    DateTime?
  dedupeKey String?
  attempts  Int       @default(0)
  lastError String?
  createdAt DateTime  @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@index([sentAt, dueAt])
}

// ---------------- Marketplace: video qo'ng'iroq (S4) ----------------

enum CallRoomStatus {
  ACTIVE
  ENDED
  REVOKED
}

model CallRoom {
  id                      String         @id @default(uuid())
  bookingId               String
  booking                 Booking        @relation("BookingCallRooms", fields: [bookingId], references: [id], onDelete: Cascade)
  roomName                String         @unique // taxmin qilib bo'lmaydigan (128 bit tasodifiy)
  provider                String
  status                  CallRoomStatus @default(ACTIVE)
  teacherKey              String // provayderdagi anonim identity (haqiqiy user id oshkor qilinmaydi)
  studentKey              String
  recordingConsentTeacher Boolean?
  recordingConsentStudent Boolean?
  createdAt               DateTime       @default(now())
  endedAt                 DateTime?
  revokedAt               DateTime?

  sessions CallSession[]
  tokens   CallTokenIssue[]

  @@index([bookingId, status])
}

model CallSession {
  id         String    @id @default(uuid())
  roomId     String
  room       CallRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  bookingId  String
  userId     String
  side       String // TEACHER | STUDENT
  source     String // CLIENT | PROVIDER
  joinedAt   DateTime
  lastSeenAt DateTime
  leftAt     DateTime?
  endReason  String?

  @@index([bookingId, side])
  @@index([bookingId, userId])
}

model CallTokenIssue {
  id        String    @id @default(uuid())
  roomId    String
  room      CallRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  issuedAt  DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([roomId, userId])
}

model CallEvent {
  id        String   @id @default(uuid())
  bookingId String
  userId    String?
  type      String
  data      Json?
  at        DateTime @default(now())

  @@index([bookingId, at])
}

// ---------------- Marketplace: xabarlar (S5) ----------------

model ChatThread {
  id                  String        @id @default(uuid())
  teacherUserId       String
  teacher             User          @relation("ThreadTeacher", fields: [teacherUserId], references: [id], onDelete: Cascade)
  studentUserId       String // o'quvchi (voyaga yetmagan bo'lsa ham o'zi)
  student             User          @relation("ThreadStudent", fields: [studentUserId], references: [id], onDelete: Cascade)
  lastSeq             Int           @default(0)
  lastMessageAt       DateTime?
  teacherLastReadSeq  Int           @default(0)
  studentLastReadSeq  Int           @default(0)
  teacherDeliveredSeq Int           @default(0)
  studentDeliveredSeq Int           @default(0)
  createdAt           DateTime      @default(now())
  messages            ChatMessage[]

  @@unique([teacherUserId, studentUserId])
  @@index([studentUserId])
}

model ChatMessage {
  id        String      @id @default(uuid())
  threadId  String
  thread    ChatThread  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  seq       Int
  senderId  String
  sender    User        @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  body      String      @default("") @db.Text
  fileId    String?     @unique
  file      StoredFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())
  deletedAt DateTime?

  @@unique([threadId, seq])
  @@index([senderId, createdAt])
}

// ---------------- Marketplace: sharhlar va shikoyatlar (S7) ----------------

enum ReviewStatus {
  VISIBLE
  HIDDEN
}

model Review {
  id           String         @id @default(uuid())
  bookingId    String         @unique
  booking      Booking        @relation("BookingReview", fields: [bookingId], references: [id], onDelete: Restrict)
  teacherId    String // TeacherProfile.id
  teacher      TeacherProfile @relation("TeacherReviews", fields: [teacherId], references: [id], onDelete: Restrict)
  authorId     String
  author       User           @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  rating       Int
  text         String         @default("") @db.Text
  status       ReviewStatus   @default(VISIBLE)
  hiddenReason String?
  teacherReply String?        @db.Text
  repliedAt    DateTime?
  editedAt     DateTime?
  createdAt    DateTime       @default(now())

  @@index([teacherId, status, createdAt])
  @@index([authorId])
}

enum ReportTargetType {
  REVIEW
  USER
  MESSAGE
  CLASS_FILE
}

enum ReportReason {
  PAYMENT_PROBLEM
  SPAM
  ABUSE
  INAPPROPRIATE
  FAKE
  PERSONAL_DATA
  SAFETY
  COPYRIGHT
  OTHER
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

model Report {
  id                String           @id @default(uuid())
  reporterId        String
  reporter          User             @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType        ReportTargetType
  targetId          String
  reason            ReportReason
  note              String           @default("") @db.Text
  status            ReportStatus     @default(OPEN)
  snapshot          Json? // shikoyat paytidagi kontent nusxasi (keyin o'chirilsa ham admin ko'ra oladi)
  resolutionNote    String?
  resolvedByAdminId String?
  resolvedAt        DateTime?
  createdAt         DateTime         @default(now())

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
  @@index([targetType, targetId])
}

// ---------------- Marketplace: to'lovlar va daftar (S8) ----------------
// Pul HAR DOIM butun son, eng kichik birlikda (tiyin; 1 so'm = 100 tiyin). Haqiqiy to'lov provayderi YO'Q: MockPaymentProvider.

enum PaymentState {
  PENDING
  PAID
  FAILED
  REFUNDED
  ON_HOLD
  DISPUTED
  UNDER_REVIEW
  RELEASED
}

model LessonPayment {
  id              String       @id @default(uuid())
  bookingId       String       @unique
  booking         Booking      @relation("BookingPayment", fields: [bookingId], references: [id], onDelete: Restrict)
  payerId         String
  teacherUserId   String
  amountMinor     Int
  currency        String       @default("UZS")
  commissionBps   Int
  state           PaymentState @default(PENDING)
  provider        String
  providerRef     String?
  idempotencyKey  String       @unique
  failureCode     String?
  earnedMinor     Int          @default(0) // o'qituvchiga hisoblangan (komissiyadan oldin)
  commissionMinor Int          @default(0)
  refundedMinor   Int          @default(0)
  releaseAt       DateTime?
  disputeReason   String?
  disputedAt      DateTime?
  resolutionNote  String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([state, releaseAt])
  @@index([teacherUserId, createdAt])
  @@index([payerId, createdAt])
}

enum LedgerAccount {
  EXTERNAL_PAYMENTS
  ESCROW
  TEACHER_PENDING
  TEACHER_AVAILABLE
  PAYOUT_PENDING
  PLATFORM_REVENUE
  EXTERNAL_PAYOUTS
}

// Qo'sh yozuvli daftar: har bir txnId bo'yicha yig'indi doim 0. O'zgartirilmaydi, o'chirilmaydi (faqat yangi yozuv).
model LedgerEntry {
  id             String        @id @default(uuid())
  txnId          String
  account        LedgerAccount
  ownerId        String?
  amountMinor    BigInt
  kind           String
  bookingId      String?
  paymentId      String?
  payoutId       String?
  idempotencyKey String        @unique
  createdAt      DateTime      @default(now())

  @@index([account, ownerId])
  @@index([txnId])
  @@index([bookingId])
}

enum PayoutStatus {
  REQUESTED
  PAID
  REJECTED
}

model PayoutRequest {
  id                String       @id @default(uuid())
  teacherUserId     String
  amountMinor       BigInt
  destination       String // masalan "Humo ****1234" — to'liq karta raqami SAQLANMAYDI
  status            PayoutStatus @default(REQUESTED)
  idempotencyKey    String       @unique
  providerRef       String?
  rejectReason      String?
  reviewedByAdminId String?
  requestedAt       DateTime     @default(now())
  paidAt            DateTime?

  @@index([teacherUserId, requestedAt])
  @@index([status, requestedAt])
}

// ---------------- Marketplace: xavfsizlik, roziliklar (S9/S10) ----------------

model UserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blocker   User     @relation("BlockerSide", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlockedSide", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// Voyaga yetmagan o'quvchi yaratadigan bir martalik kod; vasiy shu kod bilan bog'lanadi. Kod faqat HASH ko'rinishida saqlanadi.
model GuardianLinkCode {
  id        String    @id @default(uuid())
  studentId String
  student   User      @relation("LinkCodeStudent", fields: [studentId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([studentId, createdAt])
}

enum ConsentKind {
  TERMS
  PRIVACY
  GUARDIAN_STATEMENT
  MARKETING
}

model Consent {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation("UserConsents", fields: [userId], references: [id], onDelete: Cascade)
  kind        ConsentKind
  version     String
  locale      String      @default("uz")
  acceptedAt  DateTime    @default(now())
  withdrawnAt DateTime?

  @@unique([userId, kind, version])
  @@index([userId, kind])
}

// Push tokenlari (Expo Push). Token — qurilma identifikatori: shaxsiy ma'lumot hisoblanadi, akkaunt o'chirilganda o'chiriladi.
model PushToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation("UserPushTokens", fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

// ---------------- A2: o'qituvchi karta ma'lumotlari (to'g'ridan-to'g'ri to'lov uchun) ----------------
// To'liq karta raqami faqat AES-256-GCM bilan shifrlangan holda saqlanadi (APP_DATA_KEY). CVV/muddat/SMS HECH QACHON qabul qilinmaydi.
model TeacherPaymentInfo {
  id            String         @id @default(uuid())
  teacherId     String         @unique
  teacher       TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  cardNumberEnc String
  cardLast4     String
  holderName    String
  updatedAt     DateTime       @updatedAt
  createdAt     DateTime       @default(now())
}

// ---------------- A3: to'g'ridan-to'g'ri to'lovni kuzatish (platforma pul ushlamaydi) ----------------
enum PaymentTiming {
  PAY_BEFORE
  PAY_AFTER
}

enum DirectPaymentStatus {
  UNPAID
  PUPIL_MARKED_PAID
  TEACHER_CONFIRMED
  NOT_RECEIVED
  WAIVED
}

// Faqat belgi: "o'quvchi to'lagan deb belgiladi" / "o'qituvchi oldim deb tasdiqladi". Ilova to'lovni tekshirmaydi, ushlamaydi, qaytarmaydi.
model DirectPayment {
  id                 String               @id @default(uuid())
  bookingId          String               @unique
  booking            Booking              @relation("BookingDirectPayment", fields: [bookingId], references: [id], onDelete: Restrict)
  amountMinor        BigInt // dars narxi (qabul qilingan paytdagi nusxa)
  status             DirectPaymentStatus  @default(UNPAID)
  pupilMarkedAt      DateTime?
  teacherConfirmedAt DateTime?
  notReceivedAt      DateTime?
  waivedAt           DateTime?
  waivedFrom         DirectPaymentStatus?
  waivedReason       String?
  proofFileId        String?
  proofFile          StoredFile?          @relation("DirectPaymentProof", fields: [proofFileId], references: [id], onDelete: SetNull)
  lastRemindedAt     DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([status, createdAt])
}

// ===== R1: sinflar (1 o'qituvchi + 30 tagacha o'quvchi) =====
enum ClassStatus {
  ACTIVE
  CANCELLED
}

enum ClassPriceModel {
  PER_SESSION
  MONTHLY
}

enum StageMode {
  LISTEN_ONLY
  HAND_RAISE
  OPEN_STAGE
}

enum ClassChatMode {
  OPEN
  QUESTIONS_ONLY
  OFF
}

enum ClassQuestionsMode {
  OPEN
  OFF
}

enum ClassSessionStatus {
  SCHEDULED
  LOBBY
  LIVE
  ENDED
  CANCELLED
}

enum ClassEnrollmentStatus {
  ACTIVE
  REMOVED
  LEFT
}

model Class {
  id                String             @id @default(uuid())
  teacherId         String // TeacherProfile.id
  teacher           TeacherProfile     @relation("TeacherClasses", fields: [teacherId], references: [id], onDelete: Restrict)
  title             String
  subject           String
  description       String             @default("")
  capacity          Int
  enrolledCount     Int                @default(0) // atomik hisoblagich: sig'im tekshiruvi shu orqali
  priceMinor        Int                @default(0) // faqat ma'lumot uchun; ilova pul yig'maydi
  priceModel        ClassPriceModel    @default(PER_SESSION)
  weekdays          Int[] // ISO 1..7, bo'sh bo'lsa bir martalik
  startMinute       Int                @default(0) // kun boshidan daqiqa (o'qituvchi vaqt zonasida)
  durationMin       Int                @default(60)
  timezone          String             @default("Asia/Tashkent")
  startDate         DateTime? // takrorlanish boshlanishi (shu kun yoki keyin)
  endDate           DateTime? // takrorlanish tugashi (shu kungacha)
  oneOffStartAt     DateTime?
  stageMode         StageMode          @default(HAND_RAISE)
  chatMode          ClassChatMode      @default(OPEN)
  questionsMode     ClassQuestionsMode @default(OPEN)
  slowModeSeconds   Int                @default(0)
  handRaiseOn       Boolean            @default(true)
  allowDownload     Boolean            @default(true)
  requirePaidToJoin Boolean            @default(false)
  firstSessionTrial Boolean            @default(false)
  status            ClassStatus        @default(ACTIVE)
  codeHash          String             @unique
  inviteHash        String             @unique
  cancelledAt       DateTime?
  sessions          ClassSession[]
  enrollments       ClassEnrollment[]
  payments          ClassPayment[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([teacherId, status])
}

model ClassSession {
  id            String             @id @default(uuid())
  classId       String
  class         Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  startAt       DateTime
  endAt         DateTime
  status        ClassSessionStatus @default(SCHEDULED)
  isTrial       Boolean            @default(false)
  stageMode     StageMode
  chatMode      ClassChatMode
  questionsMode ClassQuestionsMode
  slowModeSeconds Int              @default(0)
  handRaiseOn   Boolean            @default(true)
  cancelledAt   DateTime?
  locked        Boolean            @default(false)
  spotlightPupilId String?
  startedAt     DateTime?
  endedAt       DateTime?
  teacherAbsentSince DateTime?
  teacherNoShow Boolean            @default(false)
  endReason     String?
  participants  ClassParticipant[]
  messages      ClassMessage[]
  presentFileId String?
  whiteboardRev Int                @default(0)
  presentedFileIds String[]        @default([])
  presentPage   Int                @default(1)
  questions     ClassQuestion[]
  attendance    ClassAttendance[]
  createdAt     DateTime           @default(now())

  @@unique([classId, startAt])
  @@index([startAt, status])
}

model ClassEnrollment {
  id           String                @id @default(uuid())
  classId      String
  class        Class                 @relation(fields: [classId], references: [id], onDelete: Cascade)
  pupilId      String
  pupil        User                  @relation("ClassPupil", fields: [pupilId], references: [id], onDelete: Restrict)
  enrolledById String
  enrolledBy   User                  @relation("ClassEnrolledBy", fields: [enrolledById], references: [id], onDelete: Restrict)
  status       ClassEnrollmentStatus @default(ACTIVE)
  endedAt      DateTime?
  createdAt    DateTime              @default(now())

  @@unique([classId, pupilId])
  @@index([pupilId, status])
}

model ClassJoinAttempt {
  id     String   @id @default(uuid())
  userId String
  at     DateTime

  @@index([userId, at])
}

enum StageState {
  NONE
  VOICE
  VOICE_VIDEO
}

// R2: sessiyadagi har bir o'quvchining holati (qo'l ko'tarish, sahna, chiqarilgan)
model ClassParticipant {
  id            String       @id @default(uuid())
  sessionId     String
  session       ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  pupilId       String
  handRaisedAt  DateTime?
  stage         StageState   @default(NONE)
  stageAt       DateTime?
  removedAt     DateTime? // shu sessiya uchun qayta kirish taqiqlangan
  updatedAt     DateTime     @updatedAt

  @@unique([sessionId, pupilId])
  @@index([sessionId, stage])
}

model ClassAttendance {
  id            String       @id @default(uuid())
  sessionId     String
  session       ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  pupilId       String
  firstJoinedAt DateTime
  lastJoinAt    DateTime?
  lastLeftAt    DateTime?
  presentNow    Boolean      @default(false)
  totalSeconds  Int          @default(0)
  joinCount     Int          @default(0)
  joinedLate    Boolean      @default(false)

  @@unique([sessionId, pupilId])
}

// Webhook hodisalarini qayta ishlashda takrorlanishdan himoya
model ClassRoomEvent {
  eventKey String   @id
  at       DateTime
}

enum ClassQuestionStatus {
  OPEN
  ANSWERED
  LATER
  HIDDEN
}

model ClassMessage {
  id          String       @id @default(uuid())
  seq         Int          @unique @default(autoincrement()) // o'sib boruvchi: uzilgandan keyin "shundan keyin" bilan davom etiladi
  sessionId   String
  session     ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  authorId    String
  body        String
  createdAt   DateTime
  deletedAt   DateTime?
  deletedById String?

  @@index([sessionId, seq])
  @@index([authorId, createdAt])
}

model ClassQuestion {
  id          String              @id @default(uuid())
  seq         Int                 @unique @default(autoincrement())
  sessionId   String
  session     ClassSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  authorId    String
  text        String
  anonymous   Boolean             @default(false) // sinfdoshlardan yashirish; o'qituvchi baribir ko'radi
  status      ClassQuestionStatus @default(OPEN)
  pinned      Boolean             @default(false)
  upvotes     Int                 @default(0)
  replyText   String?
  repliedAt   DateTime?
  createdAt   DateTime
  votes       ClassQuestionVote[]

  @@index([sessionId, seq])
  @@index([authorId, createdAt])
}

model ClassQuestionVote {
  questionId String
  question   ClassQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  voterId    String

  @@id([questionId, voterId])
}

model ClassMute {
  id        String   @id @default(uuid())
  sessionId String
  pupilId   String
  until     DateTime

  @@unique([sessionId, pupilId])
}

enum ClassFileRender {
  PREPARING
  READY
  FAILED
}

model ClassFile {
  id            String          @id @default(uuid())
  classId       String
  fileId        String          @unique // StoredFile (CLASS_FILE, PDF)
  uploaderId    String
  name          String
  allowDownload Boolean         @default(true)
  pageCount     Int             @default(0)
  renderedPages Int             @default(0)
  renderStatus  ClassFileRender @default(PREPARING)
  renderError   String?
  renderAttempts Int            @default(0)
  takedownAt    DateTime?
  deletedAt     DateTime?
  createdAt     DateTime        @default(now())

  @@index([classId, deletedAt])
}

// Sahifadagi o'qituvchi chizmalari (vektor): { strokes: [{ c: '#rrggbb', w: number, p: [[x,y],...] }] }, koordinatalar 0..1
model ClassAnnotation {
  id          String   @id @default(uuid())
  classFileId String
  page        Int
  data        Json
  updatedAt   DateTime

  @@unique([classFileId, page])
}

enum ClassFeedKind {
  WHITEBOARD
  NOTE
  HOMEWORK
  RECAP
  ANSWER
}

// Teacher doskasining oxirgi holati (vektor); yangi qo'shilgan va qayta ulangan mijozlar shuni oladi
model ClassWhiteboard {
  sessionId String   @id
  rev       Int      @default(0)
  data      Json
  updatedAt DateTime
}

// Sinf lentasi (R8 kengaytiradi): hozircha doskadan saqlangan PNG
model ClassFeedPost {
  id        String        @id @default(uuid())
  classId   String
  sessionId String?
  kind      ClassFeedKind
  authorId  String
  text      String?
  imageKey  String?
  title     String?
  data      Json?
  editedAt  DateTime?
  noteKey   String?       @unique // NOTE/RECAP uchun "kind:sessionId": bir sessiyaga bittadan
  createdAt DateTime

  @@index([classId, createdAt])
}

// R7: sinf to'lovi belgisi (faqat belgi: ilova pul ushlamaydi). Holat mashinasi DirectPayment bilan bir xil (direct-payment-rules.ts).
// periodKey: "M:YYYY-MM" (oylik narx) yoki "S:<sessionId>" (har dars uchun). Bron yo'li (DirectPayment) o'zgarmagan.
model ClassPayment {
  id                 String               @id @default(uuid())
  classId            String
  class              Class                @relation(fields: [classId], references: [id], onDelete: Cascade)
  pupilId            String
  periodKey          String
  sessionId          String?
  amountMinor        BigInt
  status             DirectPaymentStatus  @default(UNPAID)
  pupilMarkedAt      DateTime?
  teacherConfirmedAt DateTime?
  notReceivedAt      DateTime?
  waivedAt           DateTime?
  waivedFrom         DirectPaymentStatus?
  waivedReason       String?
  lastRemindedAt     DateTime?
  joinOverrideSessionId String? // o'qituvchi shu sessiya uchun ruxsat bergan
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@unique([classId, pupilId, periodKey])
  @@index([classId, periodKey, status])
  @@index([pupilId, status])
}

// Sessiya tugagach yig'iladigan xulosa (to'liq, o'qituvchi ko'rinishi); o'quvchi va vasiyga rolga qarab kesilgan ko'rinish beriladi
model ClassSessionRecap {
  sessionId String   @id
  data      Json
  createdAt DateTime
}

model ClassHomework {
  id          String   @id @default(uuid())
  classId     String
  feedPostId  String?
  title       String
  text        String   @default("")
  dueAt       DateTime
  createdAt   DateTime
  submissions ClassHomeworkSubmission[]

  @@index([classId, dueAt])
}

model ClassHomeworkSubmission {
  id          String        @id @default(uuid())
  homeworkId  String
  homework    ClassHomework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  pupilId     String
  text        String        @default("")
  fileId      String?
  submittedAt DateTime
  late        Boolean       @default(false)
  score       Int?
  comment     String?
  markedAt    DateTime?

  @@unique([homeworkId, pupilId])
  @@index([pupilId])
}
